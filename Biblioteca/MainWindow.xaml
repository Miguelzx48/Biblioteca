<Window x:Class="Biblioteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor Biblioteca"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F4F5FA">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#574EE0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#453CB3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF151DA5"/>
                    <GradientStop Color="#FFA4E8FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,35,20,20" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/book.png"
                           Width="168"
                           Height="134"
                           Stretch="Uniform"/>

                    <TextBlock x:Name="txtBienvenida"
                               Text="GESTOR BIBLIOTECA"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Padding="15"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,40,0,0">

                    <!-- ADMIN -->
                    <Button x:Name="btndashboard"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Dashboard_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/statisctics_12254889.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="DASHBOARD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLibros"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Libros_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/reading_10368713.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="LIBROS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnListaLibros"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="ListaLibros_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/books_1307864.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="LISTA LIBROS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnPrestamoAdmin"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Prestamo_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/financial-literacy_18253711.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="PRÉSTAMOS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUsuarios"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="Usuarios_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/manager_4395949.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="CREAR ADMINISTRADOR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- USUARIO -->
                    <Button x:Name="btnInicioUsuario"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="InicioUsuario_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/statisctics_12254889.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="INICIO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnPerfilUsuario"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="PerfilUsuario_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/manager_4395949.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="PERFIL" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLibrosUsuario"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="LibrosUsuario_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/reading_10368713.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="LIBROS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnPrestamosUsuario"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="PrestamosUsuario_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/financial-literacy_18253711.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="MIS PRÉSTAMOS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnMultasUsuario"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="MultasUsuario_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/financial-literacy_18253711.png" Width="50" Height="34" Margin="0,0,15,0"/>
                            <TextBlock Text="MIS MULTAS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Button Grid.Row="2"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="12,0,12,25"
                        Click="CerrarSesion_Click"
                        Background="#FF00208C">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Imagenes/arrow_16391328.png" Width="50" Height="32" Margin="0,0,15,0"/>
                        <TextBlock Text="CERRAR SESIÓN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="16"
                Margin="20"
                Padding="20">

            <Grid>
                <TextBlock Text="BIENVENIDO, SELECCIONE UNA OPCIÓN"
                           Foreground="#A0AEC0"
                           FontSize="40"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <ContentControl x:Name="MainContent"/>
            </Grid>
        </Border>
    </Grid>
</Window>