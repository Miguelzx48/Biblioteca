<Window x:Class="Biblioteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Biblioteca.Views"
        Title="Gestor Biblioteca"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F4F5FA">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI WP, Helvetica Neue"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="15,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#574EE0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#453CB3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF151DA5"/>
                    <GradientStop Color="#FFA4E8FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,35,20,20" HorizontalAlignment="Center">
                    <Image Source="/Imagenes/book.png" 
                           Width="168" 
                           Height="134" 
                           Margin="0,0,0,0"
                           Stretch="Uniform"/>
                    <TextBlock x:Name="txtBienvenida"
                               Text="GESTOR BIBLIOTECA"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               FontStretch="Expanded"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Padding="15"/>
                </StackPanel>

                <StackPanel Margin="0,302,0,0" Grid.RowSpan="2">

                    <Button x:Name="btndashboard" 
                            Background="#FF00208C"
                            Style="{StaticResource MenuButtonStyle}" 
                            Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/statisctics_12254889.png" 
                                   Width="64" Height="38" 
                                   Margin="0,0,15,0" 
                                   Stretch="Uniform"/>
                            <TextBlock Text="DASHBOARD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLibros" 
                            Style="{StaticResource MenuButtonStyle}" 
                            Click="Libros_Click"
                            Background="#FF00208C">

                        <StackPanel Orientation="Horizontal" Width="160">
                            <Image Source="/Imagenes/reading_10368713.png" 
                                   Width="59" 
                                   Height="31" 
                                   Margin="0,0,15,0" 
                                   Stretch="Uniform"/>
                            <TextBlock Text="LIBROS" 
                                       VerticalAlignment="Center"
                                       Margin="5"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" 
                            Click="ListaLibros_Click"
                            Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/books_1307864.png" Width="66" Height="31" Margin="0,0,15,0" Stretch="Uniform"/>
                            <TextBlock Text="LISTA LIBROS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButtonStyle}" 
                            Click="Prestamo_Click"
                            Background="#FF00208C">

                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/financial-literacy_18253711.png" 
                                   Width="62" 
                                   Height="41" 
                                   Margin="0,0,15,0" 
                                   Stretch="Uniform"/>
                            <TextBlock Text="PRÉSTAMOS" 
                                       VerticalAlignment="Center"
                                       Margin="3"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUsuarios" 
                            Style="{StaticResource MenuButtonStyle}" 
                            Click="Usuarios_Click" Background="#FF00208C">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Imagenes/manager_4395949.png" Width="48" Height="36" Margin="0,0,15,0" Stretch="Uniform"/>
                            <TextBlock Text="CREAR ADMINISTRADOR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <Button Grid.Row="2" Style="{StaticResource MenuButtonStyle}" Margin="12,0,12,25" Click="CerrarSesion_Click" Background="#FF00208C">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Imagenes/arrow_16391328.png" Width="58" Height="32" Margin="0,0,15,0" Stretch="Uniform"/>
                        <TextBlock Text="CERRAR SESIÓN" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="16" 
                Margin="20" 
                Padding="20">

            <Grid>
                <TextBlock Text="BIENVENIDO, SELECCIONE UNA OPCIÓN" 
                           Foreground="#A0AEC0" 
                           FontSize="40" 
                           FontWeight="Light" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>

                <ContentControl x:Name="MainContent"/>
            </Grid>

        </Border>

    </Grid>
</Window>