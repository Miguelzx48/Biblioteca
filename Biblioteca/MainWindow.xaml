<Window x:Class="Biblioteca.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Biblioteca.Views"
        Title="Biblioteca"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="#F4F5FA">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>



        <Border Background="#6C63FF">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,20" Grid.Row="0">

                    <Button x:Name="btndashboard"
                    Content="🏠 Dashboard"
                    Height="60"
                    Margin="10"
                    Click="Dashboard_Click"/>

                    <Button x:Name="btnLibros"
                    Content="📚 Libros"
                    Height="60"
                    Margin="10"
                    Click="Libros_Click"/>

                    <Button Content="📋 Lista libros"
                    Height="60"
                    Margin="10"
                    Click="ListaLibros_Click"/>

                    <Button Content="💳 Prestamos"
                    Height="60"
                    Margin="10"
                    Click="Prestamo_Click"/>

                    <Button x:Name="btnUsuarios"
                    Content="👤 Crear Administrador"
                    Height="60"
                    Margin="10"
                    Click="Usuarios_Click"/>

                </StackPanel>

                <Button Content="🚪 Cerrar sesión"
                Grid.Row="1"
                Height="60"
                Margin="10"
                VerticalAlignment="Bottom"
                Click="CerrarSesion_Click"/>

            </Grid>
        </Border>



        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>

    </Grid>

</Window>