<UserControl x:Class="Biblioteca.Views.ActualizarLibroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="#F5F7FA">
    <Grid Background="#FFCDE1FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4749ED"/>
                    <GradientStop Color="#FF0079FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="ACTUALIZAR LIBRO"
                       Foreground="White"
                       FontSize="35"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <Grid Grid.Row="1" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Nombre"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtNombre"
                             Height="35"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <TextBlock Text="Autor"
                           Margin="0,20,0,0"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtAutor"
                             Height="35"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <TextBlock Text="Categoría"
                           Margin="0,20,0,0"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtCategoria"
                             Height="35"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <TextBlock Text="Editorial"
                           Margin="0,20,0,0"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtEditorial"
                             Height="35"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Stock"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtStock"
                             Height="35"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"/>
                </Border>
                <TextBlock Text="Descripción"
                           Margin="0,20,0,0"
                           FontWeight="Bold"
                           FontSize="18"/>
                <Border CornerRadius="12"
                        Background="White"
                        BorderBrush="#BFC9D1"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10"
                                          ShadowDepth="5"
                                          Opacity="0.3"/>
                    </Border.Effect>
                    <TextBox x:Name="txtDescripcion"
                             Height="150"
                             Padding="10"
                             BorderThickness="0"
                             Background="Transparent"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Content="ACTUALIZAR"
                    Width="160"
                    Height="45"
                    Margin="10"
                    FontWeight="Bold"
                    Background="#3A8DDB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="ActualizarLibro">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="5"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="ELIMINAR"
                    Width="160"
                    Height="45"
                    Margin="10"
                    FontWeight="Bold"
                    Background="#D9534F"
                    Foreground="White"
                    BorderThickness="0"
                    Click="EliminarLibro">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="5"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>