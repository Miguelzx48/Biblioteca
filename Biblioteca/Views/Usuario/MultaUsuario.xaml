<UserControl x:Class="Biblioteca.Views.Usuario.MultaUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F5F5" Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITULO -->
        <TextBlock Text="Mis Multas"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,20"/>

        <!-- TOTAL -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,15">

            <TextBlock x:Name="txtTotalMulta"
                       Text="Multa total: $0"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

        </Border>

        <!-- TABLA -->
        <DataGrid x:Name="dgMultas"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  Background="White"
                  CanUserAddRows="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Libro"
                                    Binding="{Binding IdLibro}"
                                    Width="*"/>

                <DataGridTextColumn Header="Fecha préstamo"
                                    Binding="{Binding FechaPrestamo}"
                                    Width="*"/>

                <DataGridTextColumn Header="Fecha límite"
                                    Binding="{Binding FechaEstimadaDevolucion}"
                                    Width="*"/>

                <DataGridTextColumn Header="Fecha devolución"
                                    Binding="{Binding FechaRealDevolucion}"
                                    Width="*"/>

                <DataGridTextColumn Header="Multa"
                                    Binding="{Binding Multa}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Acción" Width="140">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Button Content="Pagar"
                                    Background="#1E293B"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnPagarClick"/>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>