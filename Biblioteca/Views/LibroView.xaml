<Window x:Class="Biblioteca.Views.LibroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Libro" Height="450" Width="400">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
       
        
        <TextBlock Text="Nombre"/>
        <TextBox x:Name="txtNombre" Grid.Row="0" Margin="100,0,0,10"/>

        <TextBlock Text="Autor" Grid.Row="1"/>
        <TextBox x:Name="txtAutor" Grid.Row="1" Margin="100,0,0,10"/>

        <TextBlock Text="Categoria" Grid.Row="2"/>
        <TextBox x:Name="txtCategoria" Grid.Row="2" Margin="100,0,0,10"/>

        <TextBlock Text="Editorial" Grid.Row="3"/>
        <TextBox x:Name="txtEditorial" Grid.Row="3" Margin="100,0,0,10"/>

        <TextBlock Text="Stock" Grid.Row="4"/>
        <TextBox x:Name="txtStock" Grid.Row="4" Margin="100,0,0,10"/>

        <TextBlock Text="Descripcion" Grid.Row="5"/>
        <TextBox x:Name="txtDescripcion" Grid.Row="5" Margin="100,0,0,10"/>

        <TextBlock Text="Año" Grid.Row="6"/>
        <TextBox x:Name="txtAnio" Grid.Row="6" Margin="100,0,0,10"/>
       

        <StackPanel Grid.Row="8"
                Orientation="Horizontal"
                Margin="0,20,0,0">

            <Button Content="Guardar"
                Width="100"
                Height="30"
                Margin="0,0,15,0"
                Click="GuardarLibro"/>

            <Button Content="Actualizar"
                Width="100"
                Height="30"
                Margin="0,0,15,0"
                />

            <Button Content="Eliminar Libro"
                Width="100"
                Height="30"
                Click="EliminarLibro"/>

        </StackPanel>

    </Grid>
</Window>