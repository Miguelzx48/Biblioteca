<UserControl x:Class="Biblioteca.Views.DetalleLibroView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650"
        Width="800"
        Background="#F5F7FA">

    <Grid Background="#FFCDE1FF">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,-8,0,8">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                    <GradientStop Color="#FF4749ED"/>
                    <GradientStop Color="#FF0079FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <TextBlock Text="DETALLE DEL LIBRO"
                       Foreground="White"
                       FontSize="35"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">

                <TextBlock Text="Nombre"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtNombre"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

                <TextBlock Text="Autor"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtAutor"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

                <TextBlock Text="Categoría"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtCategoria"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

                <TextBlock Text="Editorial"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtEditorial"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

            </StackPanel>
            <StackPanel Grid.Column="1" Margin="10">

                <TextBlock Text="Stock"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtStock"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

                <TextBlock Text="Año"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtAnio"
                         Height="35"
                         Margin="0,5,0,15"
                         IsEnabled="False"/>

                <TextBlock Text="Descripción"
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBox x:Name="txtDescripcion"
                         Height="140"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsEnabled="False"/>

                <Image x:Name="imgLibro"
                       Width="200"
                       Height="120"
                       Margin="0,10"
                       Stretch="Fill"/>
            </StackPanel>
            

        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="CERRAR"
                    Width="160"
                    Height="45"
                    Background="#3A8DDB"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="Cerrar_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="4"
                                                  Opacity="0.4"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>
</UserControl>
