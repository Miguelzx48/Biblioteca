<Window x:Class="Biblioteca.Views.Windows.CrearUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteca.Views.Windows"
        mc:Ignorable="d"
        Title="CrearUsuario" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="30 30 30 5">
            <TextBlock Text="Email*:"/>
            <TextBox Name="txtEmail" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="30,5">
            <TextBlock Text="Contraseña*:"/>
            <PasswordBox  Name="txtPassword" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="30,5">
            <TextBlock Text="Nombres*:"/>
            <TextBox Name="txtNombres" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="30,5">
            <TextBlock Text="Apellidos*:"/>
            <TextBox Name="txtApellidos" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="30,5">
            <TextBlock Text="Telefono:"/>
            <TextBox Name="txtTelefono" />
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="30,5">
            <TextBlock Text="Fecha de Nacimiento*:"/>
            <DatePicker Name="dtpckFechaNacimiento" />
        </StackPanel>
        <StackPanel Name="spActivo" Grid.Row="6" Margin="30,5" Visibility="Hidden">
            <TextBlock Text="Activo:"/>
            <CheckBox Name="chkActivo" />
        </StackPanel>
        <StackPanel Grid.Row="7" Margin="30,5" >
            <Label Name="lblResponse"/>
        </StackPanel>
        <StackPanel Grid.Row="8" Margin="30, 5">
            <Button Content="Guardar" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
