<Window x:Class="Biblioteca.Views.OlvidoPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteca.Views"
        mc:Ignorable="d"
        Title="Recuperar Contraseña"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Background="#FFCDE1FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                    <GradientStop Color="#FF4749ED"/>
                    <GradientStop Color="#FF0079FF"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="RECUPERAR CONTRASEÑA"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="White"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"
              Margin="40">
            <Border Background="White"
                    CornerRadius="20"
                    Padding="30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="5"
                                      Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Name="lblMensaje"
                               Text="Ingrese el email para restablecer la contraseña"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#333"
                               Margin="0,0,0,20"/>
                    <StackPanel Name="stcEmail"
                                Margin="0,10">
                        <TextBlock Text="Email"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <Border CornerRadius="12"
                                Background="White"
                                BorderBrush="#BFC9D1"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="3"
                                                  Opacity="0.2"/>
                            </Border.Effect>
                            <TextBox Name="txtEmail"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Name="stcBtnRecuperar"
                                Margin="0,20,0,0">
                        <Button Name="btnRecuperar"
                                Content="RECUPERAR"
                                Height="45"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="#3A8DDB"
                                Foreground="White"
                                BorderThickness="0"
                                Click="Button_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="15">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="4"
                                                              Opacity="0.4"/>
                                        </Border.Effect>
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Name="stcLblRecuperar"
                                Margin="0,25,0,10"
                                Visibility="Hidden">
                        <TextBlock Name="lblMensajeRecuperar"
                                   Text="Ingrese el código y la nueva contraseña"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#333"/>
                    </StackPanel>
                    <StackPanel Name="stcCodigo"
                                Margin="0,10"
                                Visibility="Hidden">
                        <TextBlock Text="Código"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <Border CornerRadius="12"
                                Background="White"
                                BorderBrush="#BFC9D1"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="3"
                                                  Opacity="0.2"/>
                            </Border.Effect>
                            <TextBox Name="txtCodigo"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     MaxLength="6"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Name="stcPassword"
                                Margin="0,15"
                                Visibility="Hidden">
                        <TextBlock Text="Nueva Contraseña"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <Border CornerRadius="12"
                                Background="White"
                                BorderBrush="#BFC9D1"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8"
                                                  ShadowDepth="3"
                                                  Opacity="0.2"/>
                            </Border.Effect>
                            <PasswordBox Name="txtPassword"
                                         Height="40"
                                         Padding="10"
                                         FontSize="14"
                                         BorderThickness="0"
                                         Background="Transparent"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Name="stcBtnGuardar"
                                Margin="0,20,0,0"
                                Visibility="Hidden">

                        <Button Name="btnGuardar"
                                Content="GUARDAR"
                                Height="45"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="#FF00BD14"
                                Foreground="White"
                                BorderThickness="0"
                                Click="btnGuardar_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="15">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8"
                                                              ShadowDepth="4"
                                                              Opacity="0.4"/>
                                        </Border.Effect>

                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Window>