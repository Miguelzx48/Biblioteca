<Window x:Class="Biblioteca.Views.OlvidoPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteca.Views"
        mc:Ignorable="d"
        Title="OlvidoPassword" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="30, 5">
            <Label Name="lblMensaje">Ingrese el email para reestablecer la contraseña</Label>
        </StackPanel>
        <StackPanel Name="stcEmail" Grid.Row="1" Margin="30 30 30 5">
            <TextBlock  Text="Email:"/>
            <TextBox Name="txtEmail" />
        </StackPanel>
        <StackPanel Name="stcBtnRecuperar" Grid.Row="2" Margin="30, 5" >
            <Button Name="btnRecuperar" Content="Recuperar" Click="Button_Click"/>
        </StackPanel>

        <StackPanel Name="stcLblRecuperar" Grid.Row="1" Margin="30, 5" Visibility="Hidden">
            <Label Name="lblMensajeRecuperar">Ingrese el codigo de reestablecimiento y la nueva contraseña</Label>
        </StackPanel>
        <StackPanel Name="stcCodigo" Grid.Row="2" Margin="30 30 30 5" Visibility="Hidden">
            <TextBlock Text="Codigo:"/>
            <TextBox Name="txtCodigo" MaxLength="6"/>
        </StackPanel>
        <StackPanel Name="stcPassword" Grid.Row="3" Margin="30 30 30 5" Visibility="Hidden">
            <TextBlock Text="Contraseña:"/>
            <PasswordBox Name="txtPassword" />
        </StackPanel>
        <StackPanel Name="stcBtnGuardar" Grid.Row="4" Margin="30, 5" Visibility="Hidden">
            <Button Name="btnGuardar" Content="Guardar" Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
