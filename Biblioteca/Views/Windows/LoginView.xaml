<Window x:Class="Biblioteca.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblioteca.Views"
        mc:Ignorable="d"
        Title="Login"
        Height="550"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Background="#FFCDE1FF">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0.5,0">
                    <GradientStop Color="#FF4749ED"/>
                    <GradientStop Color="#FF0079FF"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="INICIAR SESIÓN"
                           FontSize="35"
                           FontWeight="Bold"
                           Foreground="White"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1"
              Margin="40">
            <Border Background="White"
                    CornerRadius="20"
                    Padding="35">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="5"
                                      Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Email"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border CornerRadius="12"
                            Background="White"
                            BorderBrush="#BFC9D1"
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="3"
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <TextBox Name="txtEmail"
                                 Height="40"
                                 Padding="10"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Border>
                    <TextBlock Text="Contraseña"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <Border CornerRadius="12"
                            Background="White"
                            BorderBrush="#BFC9D1"
                            BorderThickness="1"
                            Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="3"
                                              Opacity="0.2"/>
                        </Border.Effect>
                        <PasswordBox Name="txtPassword"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                    </Border>
                    <Button Content="INGRESAR"
                            Height="45"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#3A8DDB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Button_Click"
                            Margin="0,10,0,20">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="15">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="4"
                                                          Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               FontSize="14">
                        <Hyperlink Click="Hyperlink_Click"
                                   Foreground="#FF0079FF">
                            ¿Olvidaste tu contraseña?
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="CREAR CUENTA"
                            Height="45"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#FF00BD14"
                            Foreground="White"
                            BorderThickness="0"
                            Click="Button_Click_1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="15">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="4"
                                                          Opacity="0.4"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Label Name="lblError"
                           Foreground="Red"
                           FontWeight="Bold"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>