<UserControl x:Class="Biblioteca.Views.UsuarioPagina.LibroUsuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="20"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                Padding="5"
                Margin="25"
                Height="55">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtBuscarLibro"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="16"
                         VerticalContentAlignment="Center"
                         Margin="10,0"
                         TextChanged="txtBuscarLibro_TextChanged"/>

                <Button Grid.Column="1"
                        Content="Buscar"
                        Background="#1E293B"
                        Foreground="White"
                        BorderThickness="0"
                        Width="45"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Cursor="Hand"/>

            </Grid>

        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="itemsLibros"
                          Margin="20">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Width="240"
                                Height="360"
                                Background="White"
                                CornerRadius="15"
                                Margin="15"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="{Binding Nombre}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"
                                           TextAlignment="Center"
                                           Margin="10,12,10,5"
                                           TextWrapping="Wrap"/>

                                <Border Width="160"
                                        Height="200"
                                        Background="#E5E7EB"
                                        CornerRadius="10"
                                        HorizontalAlignment="Center">

                                    <Image Source="{Binding Imagen}"
                                           Stretch="UniformToFill"/>

                                </Border>
 
                                <TextBlock Text="{Binding Autor}"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           TextAlignment="Center"
                                           Margin="10,10,10,5"
                                           TextWrapping="Wrap"/>

                                <Button Content="Ver detalles"
                                        Width="140"
                                        Height="35"
                                        Margin="10"
                                        Background="#1E293B"
                                        Foreground="White"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        Click="BtnVerDetallesClick"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>