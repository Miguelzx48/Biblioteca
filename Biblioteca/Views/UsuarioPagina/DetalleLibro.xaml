<UserControl x:Class="Biblioteca.Views.UsuarioPagina.DetalleLibro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Background="#F5F5F5">

        <Border Background="White"
                CornerRadius="20"
                Margin="40"
                Padding="30">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="240"
                        Height="340"
                        Background="#E5E7EB"
                        CornerRadius="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">

                    <Image x:Name="imgLibro"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="30,0,0,0">

                    <TextBlock x:Name="txtNombre"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="txtAutor"
                               FontSize="20"
                               Foreground="#475569"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtCategoria"
                               FontSize="18"
                               Margin="0,15,0,0"/>

                    <TextBlock x:Name="txtEditorial"
                               FontSize="18"
                               Margin="0,5,0,0"/>

                    <TextBlock x:Name="txtAnio"
                               FontSize="18"
                               Margin="0,5,0,0"/>

                    <TextBlock x:Name="txtStock"
                               FontSize="18"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Descripción"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,25,0,5"/>

                    <TextBlock x:Name="txtDescripcion"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Foreground="#334155"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,30,0,0">

                        <Button Content="Realizar préstamo"
                                Width="180"
                                Height="45"
                                Background="#1E293B"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnRealizarPrestamoClick"/>

                        <Button Content="Volver"
                                Width="120"
                                Height="45"
                                Margin="15,0,0,0"
                                Click="BtnVolverClick"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>