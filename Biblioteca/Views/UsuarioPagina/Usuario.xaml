<UserControl x:Class="Biblioteca.Views.UsuarioPagina.Usuario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Top de Libros por Mes"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="10"/>

        <StackPanel Grid.Row="1"
                    Margin="10">

            <TextBlock Text="Libros más prestados del mes, dirijase al apartado de libros para realizar prestamos"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Margin="0,0,0,15"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="itemsLibrosMasPrestados">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,5"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Nombre}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"/>

                                    <ProgressBar Grid.Column="1"
                                                 Value="{Binding Cantidad}"
                                                 Maximum="100"
                                                 Height="18"
                                                 VerticalAlignment="Center"
                                                 Margin="15,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Cantidad}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#1E293B"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </StackPanel>

    </Grid>

</UserControl>