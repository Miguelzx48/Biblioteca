<UserControl x:Class="Biblioteca.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F4F5FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="25">

            <TextBlock Text="Dashboard Biblioteca"
                       FontSize="30"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

        </Grid>

        <!-- CONTENIDO -->

        <Grid Grid.Row="1"
              Margin="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD GRANDE -->

            <Border Background="#6C63FF"
                    CornerRadius="25"
                    Padding="25"
                    Margin="0,0,20,0">

                <StackPanel>

                    <TextBlock Text="Resumen General"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Biblioteca"
                               Foreground="White"
                               Margin="0,10,0,0"
                               FontSize="18"/>

                    <UniformGrid Columns="3"
                                 Margin="0,40,0,0">

                        <Border Background="#847DFF"
                                CornerRadius="15"
                                Margin="10"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="125"
                                           FontSize="35"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Libros"
                                           Foreground="White"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#847DFF"
                                CornerRadius="15"
                                Margin="10"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="40"
                                           FontSize="35"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Préstamos"
                                           Foreground="White"/>

                            </StackPanel>

                        </Border>

                        <Border Background="#847DFF"
                                CornerRadius="15"
                                Margin="10"
                                Padding="20">

                            <StackPanel>

                                <TextBlock Text="18"
                                           FontSize="35"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="Usuarios"
                                           Foreground="White"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>

                </StackPanel>

            </Border>

            <!-- PANEL DERECHO -->

            <StackPanel Grid.Column="1">

                <Border Background="White"
                        CornerRadius="20"
                        Padding="20"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <TextBlock Text="Actividad"
                                   FontWeight="Bold"
                                   FontSize="22"/>

                        <TextBlock Text="Últimos préstamos realizados"
                                   Margin="0,10,0,0"
                                   Foreground="Gray"/>

                    </StackPanel>

                </Border>

                <Border Background="#FF8FB1"
                        CornerRadius="20"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Estado"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="22"/>

                        <TextBlock Text="Sistema funcionando correctamente"
                                   Margin="0,10,0,0"
                                   Foreground="White"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>