<Window x:Class="Biblioteca.Views.ListaLibrosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIBLIOTECA"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Background="#FFCDE1FF">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0">

            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF4749ED"/>
                    <GradientStop Color="#FF0079FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <TextBlock Text=" LIBROS"
                       Foreground="White"
                       FontSize="35"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>
       
                                                                                
        <Grid Grid.Row="1" Margin="20">

            <Border Background="White"
                    CornerRadius="15"
                    Padding="10">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="5"
                                      Opacity="0.3"/>
                </Border.Effect>

                <DataGrid x:Name="dgLibros"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          FontSize="14"
                          RowHeight="40">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="70"/>

                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Autor"
                                            Binding="{Binding Autor}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Categoría"
                                            Binding="{Binding Categoria}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Stock"
                                            Binding="{Binding Stock}"
                                            Width="90"/>

                        
                        <DataGridTemplateColumn Header="Actualizar"
                                                Width="120">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="Actualizar"
                                            Background="#3A8DDB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Click="Actualizar"
                                            Tag="{Binding}"
                                            BorderThickness="0"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        
                        <DataGridTemplateColumn Header="Eliminar"
                                                Width="120">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="Eliminar"
                                            Background="#D9534F"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Click="Eliminar"
                                            Tag="{Binding}"
                                            BorderThickness="0"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>